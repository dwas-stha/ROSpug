<?xml version="1.0" ?>
<launch>
    <arg name="imu" default="/imu"/>
    <arg name="odom" default="/odom_raw"/>
    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_se" clear_params="true">
        <rosparam command="load" file="$(find pug_slam)/config/ekf_template.yaml" />
         <!-- Placeholder for output topic remapping -->
        <remap from="odometry/filtered" to="odom"/>
        <param name="imu0"   value="$(arg imu)"/>
        <param name="odom0"  value="$(arg odom)"/>
    </node>
</launch>
