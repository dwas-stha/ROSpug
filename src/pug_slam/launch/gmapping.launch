<launch>
    <arg name="scan" default="/scan"/>
    <arg name="odom_raw" default="/odom_raw"/>
    <arg name="imu" default="/imu"/>
    <arg name="base_frame"  default="base_footprint"/>
    <arg name="odom_frame"  default="odom"/>

    <include file="$(find pug_peripherals)/launch/camera.launch"/>

    <include file="$(find pug_peripherals)/launch/imu.launch">
        <arg name="imu_topic" value="$(arg imu)"/>
    </include>

    <include file="$(find pug_peripherals)/launch/lidar.launch">
        <arg name="scan_filtered" value="$(arg scan)"/>
    </include>

    <include file="$(find pug_control)/launch/pug_control.launch"/>
    <include file="$(find pug_peripherals)/launch/joystick_control.launch"/>

    <include file="$(find pug_slam)/launch/include/rf2o_laser_odometry.launch">
        <arg name="scan" value="$(arg scan)"/>
        <arg name="odom" value="$(arg odom_raw)"/>
        <arg name="base_frame" value="$(arg base_frame)"/>
        <arg name="odom_frame" value="$(arg odom_frame)"/>
    </include>

    <include file="$(find pug_slam)/launch/include/ekf_template.launch">
        <arg name="imu" value="$(arg imu)"/>
        <arg name="odom" value="$(arg odom_raw)"/>
    </include>

    <include file="$(find pug_slam)/launch/include/slam_gmapping_pr2.launch">
        <arg name="scan_topic" value="$(arg scan)"/>
        <arg name="base_frame" value="$(arg base_frame)"/>
        <arg name="odom_frame" value="$(arg odom_frame)"/>
    </include>
</launch>
