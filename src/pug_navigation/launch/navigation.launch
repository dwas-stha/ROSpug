<?xml version="1.0" ?>
<launch>
    <arg name="scan" default="/scan"/>
    <arg name="odom_raw" default="/odom_raw"/>
    <arg name="imu" default="/imu"/>
    <arg name="map_frame" default="map"/>
    <arg name="base_frame"  default="base_footprint"/>
    <arg name="odom_frame"  default="odom"/>
    <arg name="initial_pose_x" default="0.0"/>
    <arg name="initial_pose_y" default="0.0"/>
    <arg name="initial_pose_a" default="0.0"/>
    <arg name="map" default="$(find pug_slam)/maps/map3.yaml"/>
    <arg name="map_file"    default="$(find pug_slam)/maps/$(arg map).yaml"/>

    <include file="$(find pug_peripherals)/launch/camera.launch"/>

    <include file="$(find pug_peripherals)/launch/imu.launch">
        <arg name="imu_topic" value="$(arg imu)"/>
    </include>

    <include file="$(find pug_peripherals)/launch/lidar.launch">
        <arg name="scan_filtered" value="$(arg scan)"/>
    </include>

    <include file="$(find pug_control)/launch/pug_control.launch"/>

    <include file="$(find pug_slam)/launch/include/rf2o_laser_odometry.launch">
        <arg name="scan" value="$(arg scan)"/>
        <arg name="odom" value="$(arg odom_raw)"/>
        <arg name="base_frame" value="$(arg base_frame)"/>
        <arg name="odom_frame" value="$(arg odom_frame)"/>
    </include>

    <include file="$(find pug_slam)/launch/include/ekf_template.launch">
        <arg name="imu" value="$(arg imu)"/>
        <arg name="odom" value="$(arg odom_raw)"/>
    </include>

  	<!-- 启动Map server功能包，发布地图 -->
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />

    <!-- 启动AMCL 自适应蒙特卡洛定位算法包 -->
    <include file="$(find pug_navigation)/launch/include/amcl.launch">
        <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
        <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
        <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
        <arg name="base_frame_id" value="$(arg base_frame)"/>
        <arg name="odom_frame_id" value="$(arg odom_frame)"/>
        <arg name="global_frame_id" value="$(arg map_frame)"/>
        <arg name="scan_topic" value="$(arg scan)"/>
    </include>

    <!-- 启动路径规划算法包-->
    <node pkg="move_base" type="move_base" respawn="true" name="move_base_node" output="screen" clear_params="true">
        <rosparam file="$(find pug_navigation)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find pug_navigation)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
        <rosparam file="$(find pug_navigation)/config/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find pug_navigation)/config/global_costmap_params.yaml" command="load" />
        <rosparam file="$(find pug_navigation)/config/base_global_planner_param.yaml" command="load" />

        <rosparam file="$(find pug_navigation)/config/teb_local_planner_params.yaml" command="load" />
        <rosparam file="$(find pug_navigation)/config/move_base_params.yaml" command="load" />

        <param name="global_costmap/global_frame"     value="$(arg map_frame)"/>
        <param name="global_costmap/robot_base_frame" value="$(arg base_frame)"/>
        <param name="local_costmap/global_frame"      value="$(arg odom_frame)"/>
        <param name="local_costmap/robot_base_frame"  value="$(arg base_frame)"/>
    </node>

    <!-- 多点导航 -->
    <node pkg="pug_navigation" type="publish_point.py" name="publish_point" output="screen">
        <param name="map_frame" value="$(arg map_frame)"/>
        <param name="clicked_point" value="clicked_point" />
        <param name="move_base_result" value="move_base/result" />
    </node>
</launch>
