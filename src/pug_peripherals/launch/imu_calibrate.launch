<?xml version="1.0"?>
<launch>
    <arg name="imu_link" default="imu_link"/>

    <include file="$(find ros_robot_controller)/launch/ros_robot_controller_node.launch">
        <arg name="freq"    value="50"/>
        <arg name="imu_link" value="$(arg imu_link)"/>
    </include>

    <node name="imu_calib" pkg="imu_calib" type="do_calib" output="screen" >
        <param name="output_file" value="$(find pug_peripherals)/config/imu_calib.yaml" />
        <remap from="/imu" to="/ros_robot_controller/imu_raw" />
    </node>
</launch>
