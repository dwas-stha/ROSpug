<?xml version="1.0"?>
<launch>
    <arg name="imu_link"    default="imu_link"/>
    <arg name="imu_topic"   default="/imu"/>
    <arg name="imu_frame"   default="imu_frame"/>
    <arg name="enable_sim"  default="false"/>
    <arg name="debug"       default="false"/>

    <group if="$(arg debug)">
        <param name="robot_description" command="$(find xacro)/xacro '$(find pug_description)/urdf/pug.urdf.xacro'" />

        <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

        <node name="tf_broadcaster_imu" pkg="pug_peripherals" type="tf_broadcaster_imu.py" output="screen">
            <param name="imu_topic" value="$(arg imu_topic)"/>
            <param name="imu_frame" value="$(arg imu_frame)"/>
            <param name="imu_link"  value="$(arg imu_link)"/>
        </node>
    </group>

    <include file="$(find ros_robot_controller)/launch/ros_robot_controller_node.launch">
        <arg name="freq"    value="50"/>
        <arg name="imu_link" value="$(arg imu_link)"/>
        <arg name="sim" value="$(arg enable_sim)"/>
    </include>

    <node name="imu_calib" pkg="imu_calib" type="apply_calib" output="screen">
        <param name="calib_file" value="$(find pug_peripherals)/config/imu_calib.yaml" />
        <remap from="raw" to="/ros_robot_controller/imu_raw" />
        <remap from="corrected" to="imu_corrected" />
    </node>

    <node name="imu_filter" pkg="imu_complementary_filter" type="complementary_filter_node">
        <param name="gain_acc" value="0.3" />
        <param name="bias_alpha" value="0.3" />
        <param name="use_mag" value="false" />
        <param name="publish_tf" value="false" />
        <remap from="imu/data_raw" to="imu_corrected" />
        <remap from="imu/data"  to="$(arg imu_topic)"/>
    </node>

    <node if="$(arg debug)" name="rviz" pkg="rviz" type="rviz" args="-d $(find pug_peripherals)/rviz/imu_view.rviz"/>
</launch>
